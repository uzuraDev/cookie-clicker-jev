# Required for the default Jev loop, and for 1HC mode when JEV_ON_TIE is on
# (the default). Never commit a real key. Vercel AI Gateway only — not a TypeSafe key.
AI_GATEWAY_API_KEY=

# Optional — default loop
# HEADLESS=false   # visible window (default is headless). Use this if Cloudflare shows "Just a moment".
# CHROME_CHANNEL=chrome   # launch installed Chrome instead of bundled Chromium
# MAX_STEPS=50     # stop after N steps (default: 50)
# EFFICIENT=true   # default. Local 80ms farms, skip Jev on a single buy. false = Jev every step.
# STEP_DELAY_MS=0  # pause after each default-loop action
# FARM_MS=8000     # cap for one farm_to_next (paced at 80ms, ~12 clicks/s)

# 1 Heavenly Chip speedrun (Golden Cookies + Fast Click). Either flag works.
# Wipes the Cookie Clicker save in this browser, then plays until the first ascension.
# SPEEDRUN_1HC=true
# MODE=1hc

# Attach to a running Chromium instead of launching one (remote debugging port).
# Reuses an existing Cookie Clicker tab. On exit, disconnects without quitting Chrome.
# CDP_URL=http://127.0.0.1:9222
# KEEP_TAB=true    # false closes the game tab on CDP disconnect (Chrome stays open)

# 1HC click gap. Default 25ms (~40/s) is separate from the efficient loop's 80ms farms.
# The efficient farm pace stays above the ~67ms Uncanny threshold. 1HC does not.

# Big-cookie click gap in ms. Default 25 (~40/s, fast-click / mouse-wheel pace).
# Game.ClickCookie() with no mouse event discards gaps under 20ms; values below 21 are raised to 21.
# Gaps under ~67ms still count, and can award Uncanny clicker. That is expected for Fast Click.
# CLICK_INTERVAL_MS=25

# Ask Jev (typesafe-ai/jev via AI Gateway) only when two purchases have similar ROI.
# Set false to run the 1HC loop on local ROI with no API key.
# JEV_ON_TIE=true
# JEV_TIE_RATIO=1.25
# JEV_MIN_INTERVAL_MS=12000

# How often to consider a purchase, and how often to print the status line.
# BUY_INTERVAL_MS=250
# LOG_INTERVAL_MS=5000

# Buy when weighted payback is under this many seconds (default 180).
# Frenzy / building-special stretches it. The Lucky bank is kept after 1e6 cookies baked.
# MAX_PAYBACK_SEC=180
# LUCKY_RESERVE=true

# Optional safety stop in milliseconds. Unset = play until ascension. A stop here is not a finish.
# SPEEDRUN_MAX_MS=
